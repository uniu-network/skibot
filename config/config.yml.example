log:
  level: TRACE
web:
  host: 0.0.0.0
  port: 3000
  username: admin
  password: admin
dashboard:
  debug: false
database:
  engine: sqlite
  sqlite:
    file: ./data/skibot.sqlite
  pgsql:
    connectionString: postgres://user:password@localhost:5432/skibot
    pool:
      min: 2
      max: 10
  message_retention_days: 0
  cleanup_time: "01:00"
  timezone: ""

# Bot configuration example (place in config/bots/<name>.yml):
# self_id: 10001
# prefix:
#   - /
#   - !
# adapters:
#   - type: onebotHttp
#     config:
#       url: http://localhost:5700
#   - type: webchat
#     config:
#       port: 8080
#       host: 0.0.0.0
