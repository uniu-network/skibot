{
  "name": "skibot",
  "version": "1.0.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "start": "npx tsc && node ./dist/index.js",
    "build": "npx tsc",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "build:all": "npm run build && npm run build:frontend",
    "build-dashboard": "npm run build:frontend",
    "preview:frontend": "vite preview --config frontend/vite.config.js",
    "create-plugin": "node scripts/createPlugin.js",
    "install-dependencies": "node scripts/installDependencies.js"
  },
  "author": "unify-z <i@itify.top>",
  "license": "ISC",
  "dependencies": {
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/static": "^1.4.10",
    "@tsconfig/node20": "^20.1.9",
    "@vicons/ionicons5": "^0.13.0",
    "async": "^3.2.6",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "echarts": "^5.6.0",
    "elysia": "^1.4.28",
    "js-cookie": "^3.0.5",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-schedule": "^2.1.1",
    "readline": "^1.3.0",
    "typescript": "^5.7.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuex": "^4.1.0",
    "ws": "^8.20.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@types/async": "^3.2.24",
    "@types/better-sqlite3": "^7.6.13",
    "@types/connect-timeout": "^0.0.39",
    "@types/cors": "^2.8.17",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vueuse/core": "^12.4.0",
    "connect-timeout": "^1.9.0",
    "naive-ui": "^2.41.0",
    "nodemon": "^3.1.9",
    "unplugin-vue-router": "^0.10.9",
    "vite": "^5.4.11",
    "vite-plugin-vue-devtools": "^7.6.8",
    "vite-plugin-vue-layouts": "^0.11.0"
  },
  "nodemonConfig": {
    "exec": "npm run build && node ./dist/index.js",
    "watch": [
      "."
    ],
    "ignore": [
      "logs/**",
      "data/**",
      "dist/**",
      "frontend/**",
      "typed-router.d.ts",
      "node_modules/**",
      "plugins/**"
    ],
    "ext": "ts,yml,json",
    "delay": "1000",
    "env": {
      "NODE_ENV": "development"
    }
  }
}
