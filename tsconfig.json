{
  "extends": ["@tsconfig/node20"],
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "strict": false
  },
  "exclude": [
    "node_modules",
    "frontend",
    "public/**/*",
    "plugins",
    "dist",
    "scripts",
    "adapters/**/frontend/**"
  ]
}
